{
  "name": "dshbanca",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin DSH para gestão, auditoria e correção de trabalhos acadêmicos (monografias, dissertações, TCCs).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/dsh.d.ts",
      "default": "./dist/dsh.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "skills",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc && bun build src/lib/tools.ts --target=node --packages=external --outfile=dist/lib/tools.js",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate:skills": "bun run scripts/validate-skills.ts",
    "validate:agents": "bun run scripts/validate-agents.ts",
    "e2e:dsh:profile": "bun run scripts/e2e-dsh-profile.ts",
    "e2e:opencode": "bun run build && bun run scripts/e2e-opencode.ts"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "yaml": "2.7.0"
  }
}
