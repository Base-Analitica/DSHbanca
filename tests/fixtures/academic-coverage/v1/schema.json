{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicCoverageCorpusManifest",
  "type": "object",
  "required": ["version", "description", "metadata", "cases"],
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": ["totalCases", "categories", "deterministicRulesEvaluated"],
      "properties": {
        "totalCases": { "type": "integer", "minimum": 1 },
        "categories": { "type": "object" },
        "deterministicRulesEvaluated": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "path", "description", "config", "expected"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["correct", "boundary", "defective", "ambiguous"]
          },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "config": { "type": "object" },
          "expected": { "type": "object" }
        }
      }
    }
  }
}
